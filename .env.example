# Database Configuration
DATABASE_USER=cc_user
DATABASE_PASSWORD=example_db_password_123
DATABASE_NAME=collaboration_catalogue
DATABASE_HOST=collaboration-catalogue-db
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:5432/${DATABASE_NAME}?schema=public

# PKI Configuration
PKI_DOMAIN=pki.example.com
PKI_USER=admin
PKI_PASSWORD=example_pki_password_456
# Basic auth hash format: username:$$apr1$$salt$$hash
# Generated with: htpasswd -nb username password
PKI_BASIC_AUTH=admin:$$apr1$$abc12345$$ExampleHashValue123

# PKI Internal Settings
CA_SUBCA_PATH=certs/subCA.p12
CA_SUBCA_KEY=example_subca_key_789
DB_PATH=certs/db.sqlite
CRL_URL=http://localhost:8000/certificates/certificates/revocation-list
CRL_EXPIRATION_DAYS=30
CERT_VALIDITY_DAYS=365

# Collaboration Catalogue Configuration
CC_DOMAIN=cc.example.com
NUXT_PKI_URL=https://${PKI_DOMAIN}
NUXT_PKI_USER=${PKI_USER}
NUXT_PKI_PASSWORD=${PKI_PASSWORD}

# Public Application URLs
NUXT_PUBLIC_APP_URL=https://${CC_DOMAIN}
NUXT_PUBLIC_OIDC_ENDPOINT=https://auth.example.com

# OIDC Configuration
NUXT_PUBLIC_OIDC_REALMS={"master":{"client_id":"admin","realm":"master"},"circuless":{"client_id":"circuless","realm":"circuless"}}
NUXT_OIDC_REALM_SECRETS={"master":"example_master_secret_abc123","circuless":"example_circuless_secret_def456"}
